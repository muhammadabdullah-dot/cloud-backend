*.db-wal
.env
run.bat
media/

# Manual safety copies taken before a migration or a data change. Never committed —
# these are whole branch/cloud databases.
*.db.bak-*
*.replaced

# Backup & Restore: settings, history and the daily backups beside cloud.db. Whole databases, never committed.
.backups/

# The server's log (server.log and its rotated copies), beside the database.
logs/
